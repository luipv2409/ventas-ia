{
  "name": "ULAT WhatsApp Cloud API con Chatbot IA (DeepSeek + RAG)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-post",
      "name": "Webhook WhatsApp POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"EVENT_RECEIVED\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-ack-meta",
      "name": "Respuesta Inmediata 200 OK (Anti-Timeout Meta)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        400,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extraer y validar de forma segura el remitente, mensaje y phone_number_id del webhook de WhatsApp\nconst entry = $input.first().json.body?.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\n\nif (!message || message.type !== 'text' || typeof message.text?.body !== 'string') {\n  return [];\n}\n\nconst remitente = String(message.from || '').replace(/[^0-9+]/g, '').slice(0, 32);\nconst phoneNumberId = String(change.metadata?.phone_number_id || '').replace(/[^0-9]/g, '').slice(0, 32);\nif (!remitente || !phoneNumberId) {\n  return [];\n}\n\nreturn [{\n  json: {\n    remitente,\n    mensaje: message.text.body.slice(0, 1200),\n    phoneNumberId,\n    nombrePostulante: String(change.contacts?.[0]?.profile?.name || 'Postulante').slice(0, 100)\n  }\n}];"
      },
      "id": "node-filter-extract",
      "name": "Filtrar y Extraer Datos de Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAT_API_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.CHAT_EXTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ canal: 'whatsapp', remitente: $json.remitente, mensaje: $json.mensaje, use_rag: true }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "node-http-chat-api",
      "name": "Llamar Motor IA ULAT (ChatEngine PHP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Filtrar y Extraer Datos de Mensaje').item.json.phoneNumberId }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_CLOUD_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $('Filtrar y Extraer Datos de Mensaje').item.json.remitente, type: 'text', text: { preview_url: false, body: String($json.whatsapp_texto || $json.respuesta || '').slice(0, 4096) } }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "node-send-whatsapp",
      "name": "Enviar Respuesta por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        380
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-get",
      "name": "Webhook WhatsApp GET (Verificación Meta)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst mode = String(q['hub.mode'] || q.hub_mode || '');\nconst token = String(q['hub.verify_token'] || q.hub_verify_token || '');\nconst rawChallenge = String(q['hub.challenge'] || q.hub_challenge || '');\nconst expected = String($env.WHATSAPP_VERIFY_TOKEN || '');\n\nif (!expected || mode !== 'subscribe' || token !== expected) {\n  return [{ json: { ok: false, statusCode: 403, body: 'Forbidden' } }];\n}\n\nconst safeChallenge = rawChallenge.replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 128);\nreturn [{ json: { ok: true, statusCode: 200, body: safeChallenge } }];"
      },
      "id": "node-verify-token",
      "name": "Validar hub.verify_token y Sanitizar Challenge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        540
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      },
      "id": "node-respond-challenge",
      "name": "Responder Desafío Meta (hub.challenge)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        540
      ]
    }
  ],
  "connections": {
    "Webhook WhatsApp POST": {
      "main": [
        [
          {
            "node": "Respuesta Inmediata 200 OK (Anti-Timeout Meta)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Filtrar y Extraer Datos de Mensaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar y Extraer Datos de Mensaje": {
      "main": [
        [
          {
            "node": "Llamar Motor IA ULAT (ChatEngine PHP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Llamar Motor IA ULAT (ChatEngine PHP)": {
      "main": [
        [
          {
            "node": "Enviar Respuesta por WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook WhatsApp GET (Verificación Meta)": {
      "main": [
        [
          {
            "node": "Validar hub.verify_token y Sanitizar Challenge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar hub.verify_token y Sanitizar Challenge": {
      "main": [
        [
          {
            "node": "Responder Desafío Meta (hub.challenge)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
