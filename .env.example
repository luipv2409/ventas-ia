# ============================================================
# CONFIGURACIÓN DE ENTORNO — VENTAS IA
# ============================================================
# Copia este archivo como .env y coloca tus credenciales reales:
#   cp .env.example .env

# Puertos en el host (libres de colisiones)
WEB_PORT=8085
DB_PORT=3307
PMA_PORT=8082

# Base de datos MySQL / MariaDB
DB_NAME=ventas_ia
DB_USER=root
DB_PASS=rootpassword

# ============================================================
# CLAVES DE INTELIGENCIA ARTIFICIAL (IA)
# Consulta la guía detallada en: GUIA_API_KEYS.md
# ============================================================

# DeepSeek (Motor principal para Valeria y Jarvis BI)
# Obtén tu clave en: https://platform.deepseek.com
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui

# Groq (Opcional - Llama 3 ultra rápido)
# Obtén tu clave en: https://console.groq.com
GROQ_API_KEY=tu_groq_api_key_aqui

# Google Gemini (Opcional - Gemini Flash)
# Obtén tu clave en: https://aistudio.google.com
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Google Sign-In Client ID (Opcional para login con Google)
# Obtén tu client id en: https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# ============================================================
# BASE DE DATOS VECTORIAL PINECONE (Opcional para RAG escalable)
# ============================================================
RAG_VECTOR_DRIVER=mysql
PINECONE_API_KEY=
PINECONE_INDEX_HOST=ventas-ia-rag-9jc19q6.svc.aped-4627-b74a.pinecone.io

