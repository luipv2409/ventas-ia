# ============================================================
# CONFIGURACIÓN DE ENTORNO — PORTAL Y CHATBOT ULAT
# ============================================================
# Copia este archivo como .env (nunca lo subas a Git):
#   cp .env.example .env
#
# Tras el primer arranque en Docker:
#   docker compose exec app php scripts/create_admin.php admin "<PASSWORD_ROBUSTA>" "Admin ULAT"
#   docker compose exec app php scripts/index_rag_ulat.php
# ============================================================

APP_DEBUG=false
APP_NAME="Universidad Latinoamericana — ULAT"
APP_URL=https://admisiones.ulat.edu.bo
# Genera con: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET_KEY=REEMPLAZAR_CON_64_HEX_ALEATORIOS

# Puerto HTTP en el host del VPS (ej. 8085 detrás de Nginx/Cloudflare)
WEB_PORT=8085
PMA_PORT=8082

# Rangos CIDR de proxies inversos confiables separados por coma.
# DEJAR VACÍO si el contenedor recibe tráfico directo sin proxy delante (usa REMOTE_ADDR).
# Si colocas Nginx en la red local/host o Cloudflare, define aquí únicamente sus CIDRs reales.
TRUSTED_PROXY_CIDRS=

# ============================================================
# BASE DE DATOS MARIADB / MYSQL (Mínimo privilegio)
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ventas_ia
DB_USER=ulat_app
DB_PASS=REEMPLAZAR_PASSWORD_APP_BD
DB_ROOT_PASS=REEMPLAZAR_PASSWORD_ROOT_BD

# ============================================================
# MOTOR CONVERSACIONAL DEEPSEEK
# ============================================================
# IMPORTANTE: Configurar límite mensual duro (Hard Spend Limit) en https://platform.deepseek.com
DEEPSEEK_API_KEY=REEMPLAZAR_CON_NUEVA_CLAVE_DEEPSEEK
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# ALMACÉN VECTORIAL RAG (Por defecto MariaDB local sin costo)
# ============================================================
RAG_VECTOR_DRIVER=mysql
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
OPENAI_API_KEY=

# ============================================================
# INTEGRACIÓN EXTERNA WHATSAPP / N8N (Opcionales; cerrados si vacíos)
# ============================================================
CHAT_EXTERNAL_API_KEY=REEMPLAZAR_CON_TOKEN_ALEATORIO_LARGO
WHATSAPP_VERIFY_TOKEN=REEMPLAZAR_CON_TOKEN_VERIFICACION_META

# ============================================================
# CUOTAS DE RATE LIMITING Y RETENCIÓN DE PRIVACIDAD
# ============================================================
CHAT_RATE_LIMIT_PER_MIN=12
CHAT_RATE_LIMIT_IP_PER_MIN=120
CHAT_RATE_LIMIT_FRONTEND_PER_MIN=15
CHAT_RATE_LIMIT_FRONTEND_PER_DAY=150
LEAD_RATE_LIMIT_PER_10MIN=5
CHAT_RETENTION_DAYS=90
LEAD_RETENTION_DAYS=365
