# ============================================================
# CONFIGURACIÓN DE ENTORNO — VENTAS IA
# ============================================================
# Copia este archivo como .env y coloca tus credenciales reales:
#   cp .env.example .env

# Puertos en el host (libres de colisiones)
WEB_PORT=8085
DB_PORT=3307
PMA_PORT=8082

# Base de datos MySQL / MariaDB
DB_NAME=ventas_ia
DB_USER=root
DB_PASS=rootpassword

# ============================================================
# CLAVES DE INTELIGENCIA ARTIFICIAL (IA)
# Consulta la guía detallada en: GUIA_API_KEYS.md
# ============================================================

# DeepSeek (Motor principal para Valeria y Jarvis BI)
# Obtén tu clave en: https://platform.deepseek.com
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui

# Groq (Opcional - Llama 3 ultra rápido)
# Obtén tu clave en: https://console.groq.com
GROQ_API_KEY=tu_groq_api_key_aqui

# Google Gemini (Opcional - Gemini Flash)
# Obtén tu clave en: https://aistudio.google.com
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Google Sign-In Client ID (Opcional para login con Google)
# Obtén tu client id en: https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# ============================================================
# BASE DE DATOS VECTORIAL PINECONE (Opcional para RAG escalable)
# NOTA: Pinecone requiere embeddings densos (OPENAI_API_KEY).
# En modo local TF-IDF, el sistema usa automáticamente MariaDB/MySQL.
# ============================================================
RAG_VECTOR_DRIVER=mysql
PINECONE_API_KEY=
PINECONE_INDEX_HOST=ventas-ia-rag-9jc19q6.svc.aped-4627-b74a.pinecone.io
OPENAI_API_KEY=tu_openai_api_key_si_usas_pinecone

# ============================================================
# CHATBOT MULTICANAL Y ENDURECIMIENTO OPERATIVO (WhatsApp / n8n)
# ============================================================
# Clave API para autenticar peticiones desde n8n / Meta (header X-API-Key o Bearer)
# OBLIGATORIA: Si está vacía, el endpoint externo responderá 503 por seguridad.
CHAT_EXTERNAL_API_KEY=genera_un_token_seguro_aqui
WHATSAPP_VERIFY_TOKEN=genera_un_token_seguro_aqui

# URL pública de la tienda para enviar enlaces de catálogo a WhatsApp (ej: https://mitienda.com)
STORE_PUBLIC_URL=http://localhost:8085

# Límites operativos del prompt y del catálogo
CHAT_CATALOG_MAX_ITEMS=60

# Rate Limiting (solicitudes por minuto)
CHAT_RATE_LIMIT_PER_MIN=12
CHAT_RATE_LIMIT_IP_PER_MIN=600
CHAT_RATE_LIMIT_FRONTEND_PER_MIN=60

# Retención de datos conversacionales (días)
CHAT_RETENTION_DAYS=90


